\]

\section*{Solution}

Method 1
\[
\begin{array}{rl}
\log _{5} 12+2 \log _{5} x & =\log _{5} 48 \\
\log _{5} 12+\log _{5} x^{2} & =\log _{5} 48 \\
\log _{5} 12 x^{2} & =\log _{5} 48 \\
12 x^{2} & =48 \\
x^{2} & =4 \\
x=2 & x<-2
\end{array}
\]
