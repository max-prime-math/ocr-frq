\[
\begin{aligned}
{ }_{n} P_{2} & ={ }_{n} C_{3} ; \text { we know } n \geq 3 \\
\frac{n!}{(n-2)!} & =\frac{n!}{(n-3)!3!} \\
\frac{n(n-1)(n-2)!}{(n-2)!} & =\frac{n(n-1)(n-2)(n-3)!}{(n-3)!6 \quad \text { we can divide by } n} \quad \begin{array}{l}
\text { and }(n-1) \text { since } \\
\text { we know } n \geq 3
\end{array} \\
6 & =\frac{n(n-1)(n-2)}{n(n-1)} \\
6 & =n-2 \\
8 & =n
\end{aligned}
\]
