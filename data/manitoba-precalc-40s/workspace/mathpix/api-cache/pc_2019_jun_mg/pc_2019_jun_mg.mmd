\section*{Solution}
![](https://cdn.mathpix.com/cropped/813a39f8-3eb3-48fb-9d35-b1d3fa2dee84-44.jpg?height=428&width=524&top_left_y=617&top_left_x=610)
\[
\begin{aligned}
& \sin \theta=-\frac{\sqrt{7}}{4} \\
& x^{2}+(\sqrt{7})^{2}=(4)^{2} \\
& x^{2}=16-7 \\
& x^{2}=9 \\
& x= \pm 3 \\
& \tan \theta=-\frac{\sqrt{7}}{3}
\end{aligned}
\]
