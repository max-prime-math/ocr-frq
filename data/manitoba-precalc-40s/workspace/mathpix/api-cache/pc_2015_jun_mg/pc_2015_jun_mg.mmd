Prove the identity for all permissible values of \(x\).
\[
\sec x+\tan x=\frac{\cos x}{1-\sin x}
\]

\section*{Solution}

\begin{tabular}[t]{|l|l|l|}
\hline \multirow[t]{2}{*}{Method 1} & & \\
\hline & Left-Hand Side & Right-Hand Side \\
\hline & \[
\begin{aligned}
& \frac{\sec x+\tan x}{\cos x}+\frac{\sin x}{\cos x} \\
& \frac{(1+\sin x)(1-\sin x)}{\cos x(1-\sin x)} \\
& \frac{1-\sin ^{2} x}{(1-\sin x) \cos x} \\
& \frac{\cos ^{2} x}{(1-\sin x) \cos x} \\
& \frac{\cos x}{1-\sin x}
\end{aligned}
\] & \begin{tabular}[t]{l}
1 mark for correct substitution of appropriate identities \\
1 mark for logical process to prove the identity \\
1 mark for algebraic strategies \\
3 marks
\end{tabular} \\
\hline
\end{tabular}

Method 2
\[
\sec x+\tan x=\frac{\cos x}{1-\sin x}
\]

\begin{tabular}[t]{|l|l|}
\hline Left-Hand Side & Right-Hand Side \\
\hline & \[
\begin{aligned}
& \frac{\cos x}{1-\sin x} \\
& \frac{\cos x(1+\sin x)}{(1-\sin x)(1+\sin x)} \\
& \frac{\cos x(1+\sin x)}{1-\sin ^{2} x} \\
& \frac{\cos x(1+\sin x)}{\cos ^{2} x} \\
& \frac{1+\sin x}{\cos x} \\
& \frac{1}{\cos x}+\frac{\sin x}{\cos x} \\
& \sec x+\tan x
\end{aligned}
\] \\
