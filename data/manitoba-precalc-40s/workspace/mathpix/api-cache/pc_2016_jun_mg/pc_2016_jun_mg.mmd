\[
\begin{aligned}
2\left(1-2 \sin ^{2} \theta\right) & =1 & & 1 \text { mark for substitution of an appropriate identity } \\
2-4 \sin ^{2} \theta & =1 & & \\
-4 \sin ^{2} \theta & =-1 & & \\
\sin ^{2} \theta & =\frac{1}{4} & & \\
\sin \theta & = \pm \frac{1}{2} & & \\
\sin \theta & =-\frac{1}{2} & & 1 \text { mark for solving for } \sin \theta\left(\frac{1}{2} \text { mark for each value }\right) \\
\theta & =\frac{7 \pi}{6}, \frac{11 \pi}{6} & & 2 \text { marks }\left(\frac{1}{2} \text { mark for each value of } \theta\right)
